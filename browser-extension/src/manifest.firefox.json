{
	"manifest_version": 3,
	"name": "Mimin Browser Bridge",
	"version": "0.2.0",
	"description": "A small bridge that lets Mimin open tabs, search Google or Scholar, and read public web pages.",
	"permissions": ["scripting", "storage"],
	"host_permissions": ["https://www.google.com/*", "https://scholar.google.com/*"],
	"optional_host_permissions": ["http://*/*", "https://*/*"],
	"action": {
		"default_title": "Mimin Browser Bridge",
		"default_popup": "popup.html"
	},
	"background": {
		"scripts": ["background.firefox.js"]
	},
	"content_scripts": [
		{
			"matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
			"js": ["config.js", "content.js"],
			"run_at": "document_start"
		}
	],
	"browser_specific_settings": {
		"gecko": {
			"id": "mimin-search@mimin.local",
			"strict_min_version": "109.0",
			"data_collection_permissions": {
				"required": ["websiteContent"]
			}
		}
	}
}
