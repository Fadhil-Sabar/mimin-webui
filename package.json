{
	"name": "mimin-webui",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"predev": "npm run extension:build",
		"build": "vite build",
		"prebuild": "npm run extension:build",
		"extension:build": "tsx scripts/build-browser-extension.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node scripts/migrate.js",
		"db:seed": "node scripts/seed.js",
		"test": "vitest run",
		"test:integration": "./scripts/test-integration.sh",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"bundle:budget": "node scripts/check-bundle-budget.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"drizzle-kit": "^0.31.4",
		"esbuild": "^0.28.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.20.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^0.84.4",
		"@earendil-works/pi-ai": "^0.84.4",
		"@lucide/svelte": "^1.38.0",
		"@napi-rs/canvas": "^1.0.8",
		"@types/prismjs": "^1.26.6",
		"better-auth": "^1.7.2",
		"dotenv": "^16.6.1",
		"drizzle-orm": "^0.45.2",
		"marked": "^18.0.11",
		"mermaid": "^11.17.2",
		"postgres": "^3.4.9",
		"prismjs": "^1.30.0",
		"unpdf": "^1.8.1",
		"zod": "^4.1.12"
	},
	"packageManager": "npm@10.9.8",
	"overrides": {
		"cookie": "0.7.2",
		"@esbuild-kit/core-utils": {
			"esbuild": "0.25.12"
		}
	}
}
