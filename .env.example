# PostgreSQL connection string. Required for persistence.
DATABASE_URL=postgres://mimin:mimin@localhost:5432/mimin

# Better Auth session signing and origin configuration.
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:5173

# Configure at least one provider for live AI responses.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional provider configuration
# Tavily API key for the web_search agent tool.
WEB_SEARCH_API_KEY=

# Optional self-hosted SearXNG endpoint URL (e.g. when enabled in docker-compose.yml)
# If set, web search will automatically default to using SearXNG.
SEARXNG_URL=


# Local file storage
STORAGE_DRIVER=local
STORAGE_PATH=./data/uploads

# Secret used to encrypt user-provided provider keys at rest.
# Generate with: openssl rand -hex 32
PROVIDER_KEY_ENCRYPTION_SECRET=replace-with-openssl-rand-hex-32
