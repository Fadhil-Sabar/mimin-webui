# Replace all replace-with-* values before starting a public deployment.
POSTGRES_USER=mimin
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
POSTGRES_DB=mimin
POSTGRES_PORT=5432

# PostgreSQL connection string for commands run on the host.
DATABASE_URL=postgres://mimin:replace-with-the-same-postgres-password@localhost:5432/mimin

# Better Auth session signing and public origin configuration.
# Leave URLs empty for local development/Compose defaults. Set both to the exact
# public HTTPS origin in production, without a trailing slash.
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=
ORIGIN=

# Initial account provisioning. Change the password before enabling AUTO_SEED.
AUTO_MIGRATE=true
AUTO_SEED=true
SEED_PASSWORD=replace-with-openssl-rand-base64-24

# Configure at least one provider for live AI responses.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional provider configuration
# Tavily API key for the web_search agent tool.
WEB_SEARCH_API_KEY=

# Optional self-hosted SearXNG endpoint URL (e.g. when enabled in docker-compose.yml)
# If set, web search will automatically default to using SearXNG.
SEARXNG_URL=
# Comma-separated origins allowed for user-configured provider/search endpoints.
# Include a local origin here when intentionally running a local service.
OUTBOUND_ALLOWED_ORIGINS=


# Local file storage
STORAGE_DRIVER=local
STORAGE_PATH=./data/uploads
# Node adapter request limit, allowing the 25 MB file limit plus multipart overhead.
BODY_SIZE_LIMIT=30M

# Project Knowledge OCR (local Tesseract; Docker includes eng+ind language data).
PDF_OCR_ENABLED=true
PDF_OCR_LANGUAGES=eng+ind
PDF_OCR_MAX_PAGES=24
PDF_OCR_TIMEOUT_MS=60000
PDF_OCR_PAGE_TIMEOUT_MS=15000
# Optional absolute path to Tesseract (defaults to the executable on PATH).
PDF_OCR_COMMAND=tesseract
PDF_OCR_MAX_CONCURRENT=2

# Semantic indexing is opt-in; sends extracted passages to this server-managed endpoint.
# Endpoint must support OpenAI-compatible /embeddings with 1536 dimensions.
KNOWLEDGE_EMBEDDINGS_ENABLED=false
KNOWLEDGE_EMBEDDING_URL=https://api.openai.com/v1/embeddings
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
# Falls back to the server OPENAI_API_KEY, never another user's saved chat provider key.
KNOWLEDGE_EMBEDDING_API_KEY=

# Secret used to encrypt user-provided provider keys at rest.
# Generate with: openssl rand -hex 32
PROVIDER_KEY_ENCRYPTION_SECRET=replace-with-openssl-rand-hex-32
